# Copy to .env.local and fill in. Never commit real values.
# Every variable below is validated at startup (src/config/env.ts): `next build` fails if one is missing.

# Resend — sends the two emails of the contact form.
# Required when CONTACT_DRY_RUN is not "true". API key from the Resend dashboard (domain clicksansbug.ch, region eu-west-1).
RESEND_API_KEY=

# Contact form
# Inbox that receives the "Nouveau projet" notification (info@clicksansbug.ch in production).
CONTACT_TO_EMAIL=
# Sender address, on the domain verified in Resend (site@clicksansbug.ch).
CONTACT_FROM_EMAIL=
# "true": validation and anti-spam run, emails are written to the server logs instead of being sent.
# "true" locally, for Playwright and for `pnpm test:actions`; "false" (or empty) on Vercel previews and production.
CONTACT_DRY_RUN=

# Site
# Public base URL, without trailing slash (https://clicksansbug.ch in production).
# Required in production. On Vercel previews, leave it unset: the deployment URL (VERCEL_URL) is used instead.
NEXT_PUBLIC_SITE_URL=

# Vercel — VERCEL_ENV is set automatically by Vercel on deployments: do not define it.
